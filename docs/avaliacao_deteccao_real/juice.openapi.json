{
  "openapi": "3.1.0",
  "info": {
    "title": "Juice Shop real — View e Manipulate Basket",
    "version": "1.0.0"
  },
  "paths": {
    "/rest/user/login": {
      "post": {
        "operationId": "login",
        "responses": {
          "200": {
            "description": "Resposta modelada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "authentication": {
                      "type": "object",
                      "properties": {
                        "bid": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "bid"
                      ]
                    }
                  },
                  "required": [
                    "authentication"
                  ]
                }
              }
            },
            "links": {
              "basket": {
                "operationId": "viewBasket",
                "parameters": {
                  "id": "$response.body#/authentication/bid"
                }
              },
              "add": {
                "operationId": "addBasketItem",
                "requestBody": {
                  "BasketId": "$response.body#/authentication/bid"
                }
              }
            }
          }
        }
      }
    },
    "/rest/basket/{id}": {
      "get": {
        "operationId": "viewBasket",
        "responses": {
          "200": {
            "description": "Resposta modelada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "id"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            },
            "x-cpn-equals": {
              "/data/id": "$request.path.id"
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      }
    },
    "/api/BasketItems": {
      "post": {
        "operationId": "addBasketItem",
        "responses": {
          "200": {
            "description": "Resposta modelada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "BasketId": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "BasketId"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            },
            "x-cpn-equals": {
              "/data/BasketId": "$request.body#/BasketId"
            }
          },
          "401": {
            "description": "BasketId negado pela aplicação"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "BasketId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "ProductId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "BasketId",
                  "ProductId",
                  "quantity"
                ]
              }
            }
          }
        }
      }
    }
  }
}
