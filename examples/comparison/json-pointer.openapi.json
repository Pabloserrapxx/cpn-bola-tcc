{
  "openapi": "3.0.3",
  "info": {
    "title": "Controlled comparison",
    "version": "1.0.0"
  },
  "paths": {
    "/login": {
      "post": {
        "operationId": "login",
        "responses": {
          "200": {
            "description": "Controlled response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "authentication": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "links": {
              "account": {
                "operationId": "getAccount",
                "parameters": {
                  "id": "$response.body#/authentication/id"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{id}": {
      "get": {
        "operationId": "getAccount",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Controlled response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
