{
  "openapi": "3.0.3",
  "info": {
    "title": "Controlled comparison",
    "version": "1.0.0"
  },
  "paths": {
    "/login": {
      "post": {
        "operationId": "login",
        "responses": {
          "200": {
            "description": "Controlled response",
            "links": {
              "items": {
                "operationId": "addItem",
                "requestBody": {
                  "BasketId": "$response.body#/authentication.id"
                }
              }
            }
          }
        }
      }
    },
    "/items": {
      "post": {
        "operationId": "addItem",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "BasketId": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Controlled response"
          }
        }
      }
    }
  }
}
